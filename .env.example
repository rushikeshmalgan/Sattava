# ── Firebase ──
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID

# ── Google Sign-In ──
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=YOUR_GOOGLE_EXPO_CLIENT_ID

# ── Sattava API (AI gateway, data API and food proxy) ──
# Public URL only. AI provider keys, the MongoDB connection string and FatSecret credentials live in
# backend/.env (see backend/.env.example) and are NEVER bundled into the app. The app has no database client:
# users and daily logs are read and written through this API, with the signed-in user's Firebase ID token.
# For local development leave this commented out: a phone finds the backend on your Wi-Fi network, and a browser
# (Expo web) uses http://localhost:3000. Set it for a deployed backend.
# EXPO_PUBLIC_PROXY_BASE_URL=https://your-api.example.com

