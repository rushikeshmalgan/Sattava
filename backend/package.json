{
  "name": "sattava-backend",
  "version": "1.0.0",
  "description": "Sattava API: authenticated AI gateway (Gemini) and FatSecret proxy",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "check:models": "tsx scripts/check-gemini-models.ts",
    "summarize:logs": "tsx scripts/summarize-ai-logs.ts",
    "smoke:vision": "tsx scripts/smoke-vision.ts",
    "smoke:coach": "tsx scripts/smoke-coach.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.4.0",
    "mongodb": "^6.21.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "~5.9"
  },
  "engines": {
    "node": ">=20.3"
  }
}
