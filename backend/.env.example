# ── Required ──────────────────────────────────────────────────────────────
# Gemini API key. Server-side ONLY. Never put this in the Expo app or EAS env.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Firebase project ID (public value). Used to verify Firebase ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Random secret (16+ chars) used to HMAC user IDs before they are logged.
LOG_SALT=change-me-to-a-long-random-string
# MongoDB connection string. Server-side ONLY, and a secret: it contains the database password. Never put it in the
# Expo app or in EAS variables. The server refuses to start without it.
#   Local MongoDB:  mongodb://127.0.0.1:27017
#   Atlas:          mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# (Atlas: Network Access must allow this server, and a password with symbols must be URL-encoded.)
MONGODB_URI=mongodb://127.0.0.1:27017

# ── Optional ──────────────────────────────────────────────────────────────
PORT=3000
# Ordered best-first, comma-separated. The default chain lives in src/config.ts (the single place
# model names are defined), so leave this commented out unless you need to override it. Models get
# retired: run `npm run check:models` before changing the chain, and after any Gemini deprecation notice.
# GEMINI_MODEL_CHAIN=
# Gemini 3.x thinks by default (~10s for vision). "minimal" gives ~4x lower latency. "off" omits the setting.
GEMINI_THINKING_LEVEL=minimal
# Comma-separated browser origins allowed by CORS (native apps need none). In development the Expo web dev server
# (http://localhost:8081, http://localhost:19006) is allowed by default; setting this replaces that default.
CORS_ORIGINS=
# Proxy hops to trust for req.ip (Render = 1).
TRUST_PROXY_HOPS=1
# Global cap on Gemini attempts per UTC day (cost guard). It is also an availability limit: once it is
# used up, every AI request fails with AI_UNAVAILABLE until 00:00 UTC. Each fallback attempt counts.
AI_DAILY_ATTEMPT_BUDGET=3000

# Time limits in milliseconds: one Gemini attempt, and one whole request across the fallback chain.
# Defaults shown; uncomment to change.
# GEMINI_ATTEMPT_TIMEOUT_MS=12000
# AI_DEADLINE_MS=30000

# Database name inside the cluster.
# MONGODB_DB=sattava

# Request limits per verified user (per minute / per day) and per client IP (per minute, all /api/v1 traffic). Defaults shown.
# DATA_RATE_PER_MINUTE=120
# VISION_RATE_PER_MINUTE=6
# VISION_RATE_PER_DAY=60
# COACH_RATE_PER_MINUTE=20
# COACH_RATE_PER_DAY=200
# AI_IP_RATE_PER_MINUTE=300
# FOODS_IP_RATE_PER_MINUTE=30

# development (default) | production | test. Production only hides the dev-only "phone-reachable" LAN URL log lines.
# NODE_ENV=production
# Log level: fatal | error | warn | info (default) | debug | trace.
# LOG_LEVEL=info

# FatSecret proxy (optional; the /api/foods/search route returns 503 if unset)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
