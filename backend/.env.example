# ── Required ──────────────────────────────────────────────────────────────
# Gemini API key. Server-side ONLY. Never put this in the Expo app or EAS env.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Firebase project ID (public value). Used to verify Firebase ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Random secret (16+ chars) used to HMAC user IDs before they are logged.
LOG_SALT=change-me-to-a-long-random-string

# ── Optional ──────────────────────────────────────────────────────────────
PORT=3000
# Ordered best-first, comma-separated. The default chain lives in src/config.ts (the single place
# model names are defined), so leave this commented out unless you need to override it. Models get
# retired: run `npm run check:models` before changing the chain, and after any Gemini deprecation notice.
# GEMINI_MODEL_CHAIN=
# Gemini 3.x thinks by default (~10s for vision). "minimal" gives ~4x lower latency. "off" omits the setting.
GEMINI_THINKING_LEVEL=minimal
# Comma-separated browser origins allowed by CORS (native apps need none).
CORS_ORIGINS=
# Proxy hops to trust for req.ip (Render = 1).
TRUST_PROXY_HOPS=1
# Global cap on Gemini attempts per UTC day (cost guard).
AI_DAILY_ATTEMPT_BUDGET=3000

# FatSecret proxy (optional; the /api/foods/search route returns 503 if unset)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
